{
  "name": "ts-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "test": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=test-report.json",
    "arch": "depcruise src --config .dependency-cruiser.json",
    "deadcode": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "knip": "6.39.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
